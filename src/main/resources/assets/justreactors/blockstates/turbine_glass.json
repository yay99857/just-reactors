    { "when": { "down":  "false" }, "apply": { "model": "justreactors:block/turbine_glass_face", "x": 90 } },

    { "when": { "north": "false", "up":    "false" }, "apply": { "model": "justreactors:block/turbine_glass_edge_top",    "y": 0 } },
